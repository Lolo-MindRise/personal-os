# Settings of the real instance. Copy this file to
#   ~/.config/personal-os/instance.env
# (or point PERSONAL_OS_INSTANCE_ENV at another file) and edit the values.
# It is read by scripts/start.sh, stop.sh and deploy-local.sh as a shell file:
# no spaces around "=", quote values that contain spaces.
# Never commit the real file.

# Directory with the database, logs, PID file and local backups.
# Required. Must be on the Linux filesystem, outside the repository.
PERSONAL_OS_DATA_DIR=/path/to/personal-os-data

# Second location for backup copies, ideally another physical disk.
# Optional: leave empty to disable the mirror. If it is unreachable the app
# keeps running and shows a warning.
PERSONAL_OS_BACKUP_MIRROR_DIR=/path/to/backup-mirror

# Port the app listens on (127.0.0.1 only). Optional, default 5310.
PORT=5310
